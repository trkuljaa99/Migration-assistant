# Copy to secrets.toml (never commit it).
ANTHROPIC_API_KEY = "..."
# The first admin, created on start (needed on Streamlit Community Cloud, whose disk is wiped at restarts).
ADMIN_EMAIL = "you@example.com"
ADMIN_PASSWORD = "a-strong-password"
ADMIN_NAME = "Your Name"
# Optional: another model, or an Anthropic-compatible gateway (e.g. the company's internal LLM endpoint).
# LLM_MODEL = "claude-opus-5-5"
# LLM_BASE_URL = "https://llm-gateway.example.internal"
